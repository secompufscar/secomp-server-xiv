# Configurações do Servidor
PORT=3000

# Configurações do Banco de Dados
DB_USER=your_db_user
DB_PASS=your_db_password
DB_PORT=3306

# URLs de conexão (Prisma, etc.)
DATABASE_URL="mysql://${DB_USER}:${DB_PASS}@localhost:${DB_PORT}/secomp"
SHADOW_DATABASE_URL="mysql://${DB_USER}:${DB_PASS}@localhost:${DB_PORT}/secomp_db"

# Autenticação JWT: obrigatórios, distintos, aleatórios, mínimo 32 bytes cada.
# Gere cada valor separadamente: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# A API recusa iniciar com valores vazios, curtos, repetidos ou placeholders.
JWT_SECRET=""
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_TTL_DAYS=30
JWT_RESET_SECRET=""
EMAIL_SECRET=""

# Configuração de e-mail transacional
BREVO_API_KEY=your_brevo_api_key

# Usar development ou production
NODE_ENV=development

# Limites HTTP e origens permitidas (separadas por vírgula)
HTTP_BODY_LIMIT=1mb
UPLOAD_MAX_MB=8
TRUST_PROXY_HOPS=1
CORS_ORIGINS=http://localhost:8081,http://localhost:3000,https://secompufscar.com.br,https://app.secompufscar.com.br,https://secomp-app-xiv.vercel.app
# CORS_ORIGINS acrescenta origens à lista histórica; não remove clientes publicados.
# Use apenas a origem (protocolo + host + porta), sem /App/Home nem outros caminhos.
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX_FAILURES=20
ACCOUNT_RATE_LIMIT_WINDOW_MINUTES=60
ACCOUNT_RATE_LIMIT_MAX_REQUESTS=20

# Ambiente de desenvolvimento
BASE_URL_DEV=http://localhost:3000/api/v1

# Ambiente de produção
BASE_URL_PROD=https://api.secompufscar.com.br/api/v1

# Keys para acessar o Armazenamento em Nuvem
CLOUDINARY_CLOUD_NAME = "secompufscar"
CLOUDINARY_API_KEY= "123456789012345"
CLOUDINARY_API_SECRET = "your_cloudinary_api_secret"

# Configurações do Frontend
EXPO_ACCESS_TOKEN=seu_token_expo

# Compatibilidade dos aplicativos publicados
# Ative apenas depois que o APK/AAB compatível estiver disponível para atualização.
APP_VERSION_ENFORCEMENT_ENABLED=false
APP_ANDROID_MIN_VERSION=1.0.0
APP_ANDROID_LATEST_VERSION=1.0.0
APP_ANDROID_UPDATE_URL=https://play.google.com/store/apps/details?id=com.secompufscar.app
APP_IOS_MIN_VERSION=1.0.0
APP_IOS_LATEST_VERSION=1.0.0
APP_IOS_UPDATE_URL=https://app.secompufscar.com.br
