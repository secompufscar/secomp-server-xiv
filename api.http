@baseUrl = http://localhost:3000

# Exemplos para teste local. Credenciais e identificadores devem vir do ambiente local.
# Nao cole tokens reais neste arquivo rastreado.

### Testando criação de usuário

POST {{baseUrl}}/api/v1/users/signup
Content-Type: application/json

{
    "email": "participante@example.com",
    "nome": "Participante de teste",
    "senha": "{{$processEnv SECOMP_TEST_PASSWORD}}"
}

### Testando login de usuário já cadastrado
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{
    "email": "participante@example.com",
    "senha": "{{$processEnv SECOMP_TEST_PASSWORD}}"
}

### Testando login de usuário não cadastrado
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{
    "email": "participante@example.com",
    "senha": "{{$processEnv SECOMP_TEST_PASSWORD}}"
}

### Testando login de usuário com senha errada
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{
    "email": "participante@example.com",
    "senha": "{{$processEnv SECOMP_TEST_PASSWORD}}"
}

### Testando login com sucesso
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{
    "email": "participante@example.com",
    "senha": "{{$processEnv SECOMP_TEST_PASSWORD}}"
}

### Testando registro de token de push
POST {{baseUrl}}/api/v1/users/registerPushToken
Authorization: Bearer {{$processEnv SECOMP_ACCESS_TOKEN}}
Content-Type: application/json

{
    "token": "{{$processEnv SECOMP_TEST_PUSH_TOKEN}}"
}


### Enviar notificação push para um usuário
POST {{baseUrl}}/api/v1/notifications/send
Authorization: Bearer {{$processEnv SECOMP_ACCESS_TOKEN}}
Content-Type: application/json

{
  "recipientIds": ["{{$processEnv SECOMP_TEST_USER_ID}}"],
  "title": "SECOMP UFSCar",
  "message": "Você acabou de receber uma notificação!",
  "data": {
    "tipo": "teste"
  },
  "sound": true,
  "badge": 1
}

### Enviar notificação push para todos os usuários
POST {{baseUrl}}/api/v1/notifications/send-to-all
Authorization: Bearer {{$processEnv SECOMP_ACCESS_TOKEN}}
Content-Type: application/json

{
  "title": "SECOMP UFSCar",
  "message": "Esta é uma notificação enviada para todos os usuários!",
  "data": {
    "tipo": "geral"
  },
  "sound": true,
  "badge": 1
}

### Obter histórico de notificações por usuário
GET {{baseUrl}}/api/v1/notifications/history
Authorization: Bearer {{$processEnv SECOMP_ACCESS_TOKEN}}
Content-Type: application/json

{
  "userId": "{{$processEnv SECOMP_TEST_USER_ID}}"
}